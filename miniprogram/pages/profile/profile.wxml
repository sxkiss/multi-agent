<!--pages/profile/profile.wxml——设置页（tab「我的」）-->
<view class="page" style="font-size:{{fontPx}}rpx">

  <view class="card">
    <view class="card-head"><text class="card-title">显示</text></view>
    <view class="row">
      <text class="row-label">正文字号</text>
      <view class="seg">
        <view
          wx:for="{{fontOptions}}"
          wx:key="key"
          class="seg-item {{fontSize === item.key ? 'on' : ''}}"
          data-key="{{item.key}}"
          catchtap="setFontSize"
        >{{item.label}}</view>
      </view>
    </view>
    <text class="row-hint">影响首页与对话气泡的正文字号</text>
  </view>

  <view class="card">
    <view class="card-head"><text class="card-title">微信机器人</text></view>

    <!-- 已连接：显示状态 -->
    <block wx:if="{{botStatus === 'active'}}">
      <view class="row">
        <text class="row-label">状态</text>
        <text class="row-value bot-on">已连接</text>
      </view>
      <text class="row-hint">你的专属微信机器人已上线。在微信里给它发消息，即可与小程序共享同一条会话</text>
      <view class="row" catchtap="disconnectBot">
        <text class="row-label danger">断开机器人</text>
      </view>
    </block>

    <!-- 等待扫码：展示二维码 -->
    <block wx:elif="{{botStatus === 'waiting' || botStatus === 'scaned'}}">
      <view class="bot-qr-wrap">
        <image class="bot-qr" src="{{botQr}}" mode="aspectFit" catchlongpress="saveBotQr"></image>
        <text class="bot-qr-tip">
          {{botStatus === 'scaned' ? '已扫码，请在手机上确认' : '用微信扫码，登录你的专属机器人'}}
        </text>
      </view>
      <text class="row-hint">扫码后，你的微信就是这个机器人的主人。长按二维码可保存到相册</text>
    </block>

    <!-- 过期 / 出错 -->
    <block wx:elif="{{botStatus === 'expired' || botStatus === 'error'}}">
      <view class="row" catchtap="connectBot">
        <text class="row-label">连接微信机器人</text>
        <text class="row-value">重新获取二维码</text>
      </view>
      <text class="row-hint">{{botError || '二维码已过期，请重新获取'}}</text>
    </block>

    <!-- 未连接 -->
    <block wx:else>
      <view class="row" catchtap="connectBot">
        <text class="row-label">连接微信机器人</text>
        <text class="row-value">{{botLoading ? '获取中…' : '扫码连接'}}</text>
      </view>
      <text class="row-hint">每个用户拥有独立的微信机器人。扫码登录后，在微信里与它对话，记录与小程序同步</text>
    </block>
  </view>

  <view class="card">
    <view class="card-head"><text class="card-title">存储</text></view>
    <view class="row" catchtap="clearCache">
      <text class="row-label">清除缓存</text>
      <text class="row-value">{{storageSize || '—'}}</text>
    </view>
    <text class="row-hint">清除本机缓存，服务端数据会自动恢复</text>
  </view>

  <view class="card">
    <view class="row" catchtap="logout">
      <text class="row-label danger">退出登录</text>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <text class="row-label">版本</text>
      <text class="row-value">v{{version}}</text>
    </view>
    <view class="row">
      <text class="row-label">账号</text>
      <text class="row-value">{{uidMasked}}</text>
    </view>
    <text class="row-hint">数据已同步到账号，换设备自动恢复</text>
  </view>

  <view class="foot">聊天记录与个人数据均保存在服务端</view>
</view>

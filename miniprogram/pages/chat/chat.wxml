<!--pages/chat/chat.wxml——tab「连接机器人」-->
<!--
  页面职责说明（重要）：
  本页 tab 已由「对话」改名为「连接机器人」，主职责变为微信机器人的连接管理。
  原有的对话 UI（消息列表 / 输入框 / 快捷指令 / 长按菜单）**并未删除**，
  而是整体包在 `wx:if="{{!chatHidden}}"` 里隐藏，代码、样式、逻辑全部保留，
  把 chatHidden 改为 false 即可完整恢复。
-->
<view class="page" style="font-size:{{fontPx}}rpx">

  <!-- ══════════ 机器人连接区（本页主界面）══════════ -->
  <scroll-view class="bot-scroll" scroll-y="{{true}}">
    <view class="bot-card">
      <view class="bot-card-head"><text class="bot-card-title">微信机器人</text></view>

      <!-- 已连接 -->
      <block wx:if="{{botStatus === 'active'}}">
        <view class="bot-row">
          <text class="bot-row-label">状态</text>
          <text class="bot-row-value bot-on">已连接</text>
        </view>

        <!-- 忙碌条：微信里发来消息、正在生成回复时显示。
             无此条时用户发了消息看不到任何反馈，会以为机器人挂了。 -->
        <view wx:if="{{botBusy}}" class="bot-busy">
          <view class="bot-busy-dot"></view>
          <text class="bot-busy-text">
            正在处理微信消息{{botBusyPeer ? '（' + botBusyPeer + '）' : ''}}… {{botBusyElapsed}}s
          </text>
          <text wx:if="{{botBusyPreview}}" class="bot-busy-preview">{{botBusyPreview}}</text>
        </view>

        <!-- 已连接后的使用说明。
             这段是必要的：扫码完用户不知道"接下来去哪说话"，最常见的问题是
             在小程序里等回复、或不知道要在微信里搜什么名字。
             第 1 条做成可点复制：clawbot 在微信里是机器人（ilink 通道），没有
             可跳转的 URL/appid，小程序也无法调起微信原生搜索页，因此只能帮
             用户把关键词放进剪贴板，由他去微信粘贴 —— 这已是当前最短路径。 -->
        <view class="bot-guide">
          <text class="bot-guide-title">怎么开始对话</text>
          <view class="bot-guide-copy" bindtap="copyBotName">
            <text class="bot-hint bot-guide-step">1. 打开微信，搜索「{{botSearchName}}」</text>
            <text class="bot-guide-copy-btn">复制</text>
          </view>
          <text class="bot-hint">2. 直接发消息即可，它会实时处理并回复你</text>
          <text class="bot-hint">3. 对话记录与小程序同步，两边是同一条会话</text>
          <text class="bot-hint bot-guide-note">提示：机器人只回复你在微信里发来的消息；换个微信号扫码会得到一个独立机器人</text>
        </view>
        <view class="bot-row bot-row-tap" bindtap="disconnectBot">
          <text class="bot-row-label danger">断开机器人</text>
        </view>
      </block>

      <!-- 等待扫码：展示二维码 -->
      <block wx:elif="{{botStatus === 'waiting' || botStatus === 'scaned'}}">
        <view class="bot-qr-wrap">
          <!-- show-menu-by-longpress：微信原生长按菜单（识别图中二维码 / 保存图片 /
             转发朋友 / 收藏），无需自己写 ActionSheet。
             注意 src 必须用 resolveQrSrc() 落盘后的本地路径——直接给 data URI
             时原生长按识别在部分机型上不触发。 -->
          <image
            class="bot-qr"
            src="{{botQrSrc}}"
            mode="aspectFit"
            show-menu-by-longpress="{{true}}"
          ></image>
          <text class="bot-qr-tip">
            {{botStatus === 'scaned' ? '已扫码，请在手机上确认' : '用微信扫码，登录你的专属机器人'}}
          </text>
        </view>
        <text class="bot-hint">扫码后，你的微信就是这个机器人的主人。长按二维码可识别、保存或转发</text>
        <view class="bot-row bot-row-tap" bindtap="disconnectBot">
          <text class="bot-row-label danger">取消连接</text>
        </view>
      </block>

      <!-- 过期 / 出错 -->
      <block wx:elif="{{botStatus === 'expired' || botStatus === 'error'}}">
        <view class="bot-row bot-row-tap" bindtap="connectBot">
          <text class="bot-row-label">连接微信机器人</text>
          <text class="bot-row-value">重新获取二维码</text>
        </view>
        <text class="bot-hint">{{botError || '二维码已过期，请重新获取'}}</text>
      </block>

      <!-- 未连接 / 未知 -->
      <block wx:else>
        <view class="bot-row bot-row-tap" bindtap="connectBot">
          <text class="bot-row-label">连接微信机器人</text>
          <text class="bot-row-value">{{botLoading ? '获取中…' : '扫码连接'}}</text>
        </view>
        <text class="bot-hint">每个用户拥有独立的微信机器人。扫码登录后，在微信里与它对话，记录与小程序同步</text>
      </block>
    </view>
  </scroll-view>

  <!-- ══════════ 以下为对话 UI：已隐藏，代码保留 ══════════ -->
  <block wx:if="{{!chatHidden}}">
    <scroll-view class="list" scroll-y="{{true}}" scroll-into-view="{{scrollToBottom}}" scroll-with-animation="{{true}}">
      <view wx:if="{{!messages.length && !quickVisible}}" class="empty">
        <view class="empty-title">有什么可以帮你的？</view>
        <view class="empty-sub">试试下面的快捷指令，或直接输入</view>
      </view>

      <block wx:for="{{messages}}" wx:key="index">
        <view id="msg-{{index}}" class="msg {{item.role}}">
          <view
            class="bubble {{item.role}} {{longPressIndex === index ? 'pressed' : ''}}"
            data-index="{{index}}"
            bindtouchstart="onBubbleTouchStart"
            bindtouchend="onBubbleTouchEnd"
            bindtouchmove="onBubbleTouchMove"
          >
            <!-- 思维链（thinking）绝不展示原文：模型的思考过程会复述系统提示词、
                 暴露内部指令与服务端信息（实测出现过「渠道约束：小程序」等条款原文）。
                 终端用户只需知道"在思考"，故统一显示占位文案。 -->
            <block wx:if="{{item.role === 'ai' && item.thinking && !item.done}}">
              <view class="think">思考中…</view>
            </block>

            <!-- 按块渲染：文本走 rich-text，代码块/图片用原生组件以支持交互 -->
            <block wx:for="{{item.blocks}}" wx:for-item="blk" wx:for-index="bi" wx:key="bi">
              <rich-text wx:if="{{blk.type === 'text'}}" class="content md" nodes="{{blk.html}}"></rich-text>

              <view wx:elif="{{blk.type === 'code'}}" class="code-block">
                <view class="code-head">
                  <text class="code-lang">{{blk.lang || 'code'}}</text>
                  <text wx:if="{{blk.open}}" class="code-open">生成中…</text>
                  <view
                    wx:else
                    class="code-copy"
                    data-index="{{index}}"
                    data-bi="{{bi}}"
                    catchtap="copyCode"
                  >复制</view>
                </view>
                <scroll-view class="code-body" scroll-x="{{true}}">
                  <text class="code-text" user-select="{{true}}">{{blk.code}}</text>
                </scroll-view>
              </view>

              <image
                wx:elif="{{blk.type === 'image'}}"
                class="md-image"
                src="{{blk.url}}"
                mode="widthFix"
                lazy-load="{{true}}"
                data-url="{{blk.url}}"
                data-index="{{index}}"
                bindtap="previewImage"
                bindlongpress="onImageLongPress"
              />
            </block>

            <view wx:if="{{item.role === 'ai' && !item.done && !item.content}}" class="typing">思考中…</view>
          </view>
        </view>
      </block>
    </scroll-view>

    <view wx:if="{{statusText}}" class="status">{{statusText}}</view>

    <!-- 快捷指令面板 -->
    <view wx:if="{{quickVisible}}" class="quick-panel">
      <view class="quick-head">
        <text class="quick-title">快捷指令</text>
        <text class="quick-close" catchtap="toggleQuick">收起</text>
      </view>
      <view class="quick-list">
        <view
          wx:for="{{QUICK_PROMPTS}}"
          wx:key="index"
          class="quick-item"
          data-text="{{item}}"
          catchtap="useQuickPrompt"
        >{{item}}</view>
      </view>
    </view>

    <view class="composer">
      <view class="composer-row">
        <view class="icon-btn" catchtap="toggleQuick">
          <text class="icon-text">⚡</text>
        </view>

        <!-- 语音与键盘输入互斥：避免"边说边改"造成内容错乱 -->
        <block wx:if="{{!voiceMode}}">
          <input
            class="input"
            value="{{input}}"
            placeholder="输入消息…"
            bindinput="onInput"
            bindconfirm="send"
            confirm-type="send"
            disabled="{{sending}}"
            adjust-position="{{true}}"
          />
        </block>
        <block wx:else>
          <view
            class="voice-btn {{recording ? 'recording' : ''}}"
            bindtouchstart="startRecord"
            bindtouchend="stopRecord"
            bindtouchcancel="cancelRecord"
          >
            <text class="voice-text">{{recording ? '松开 发送' : '按住 说话'}}</text>
          </view>
        </block>

        <view class="icon-btn" catchtap="toggleVoiceMode">
          <text class="icon-text">{{voiceMode ? '⌨' : '🎙'}}</text>
        </view>

        <block wx:if="{{sending}}">
          <button class="btn stop" size="mini" bindtap="stop">停止</button>
        </block>
        <block wx:else>
          <button class="btn" size="mini" type="primary" bindtap="send">发送</button>
        </block>
      </view>
    </view>

    <!-- 长按消息菜单 -->
    <view wx:if="{{menuVisible}}" class="mask" bindtap="hideMenu"></view>
    <view wx:if="{{menuVisible}}" class="action-sheet">
      <view class="as-title">消息操作</view>
      <view class="as-item" data-act="copy" catchtap="onMenuAction">复制全文</view>
      <view class="as-item" data-act="copyCode" catchtap="onMenuAction">复制代码</view>
      <view class="as-item" data-act="share" catchtap="onMenuAction">分享给好友</view>
      <view class="as-item" data-act="regen" catchtap="onMenuAction">重新生成</view>
      <view wx:if="{{menuMessage.images.length}}" class="as-item" data-act="saveImage" catchtap="onMenuAction">保存图片</view>
      <view class="as-item danger" data-act="delete" catchtap="onMenuAction">删除这条</view>
      <view class="as-cancel" catchtap="hideMenu">取消</view>
    </view>
  </block>
</view>
